{
  "name": "@spechtlabs/backstage-plugin-tailscale",
  "version": "0.1.1",
  "description": "Tailscale for Backstage: a tailnet policy console with an access map and access preview, a Policy tab on policy entities, and tailnet access cards on catalog entity pages.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SpechtLabs/backstage-plugin-tailscale/tree/main/plugins/tailscale#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpechtLabs/backstage-plugin-tailscale.git",
    "directory": "plugins/tailscale"
  },
  "bugs": {
    "url": "https://github.com/SpechtLabs/backstage-plugin-tailscale/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "tailscale",
    "tailnet",
    "acl",
    "policy"
  ],
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "tailscale",
    "pluginPackages": [
      "@spechtlabs/backstage-plugin-catalog-backend-module-tailscale",
      "@spechtlabs/backstage-plugin-tailscale",
      "@spechtlabs/backstage-plugin-tailscale-backend",
      "@spechtlabs/backstage-plugin-tailscale-common"
    ]
  },
  "sideEffects": [
    "*.css",
    "*.css.esm.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.3",
    "@backstage/core-components": "^0.18.16",
    "@backstage/frontend-plugin-api": "^1.0.0",
    "@backstage/plugin-catalog-react": "^4.0.0",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.9.1",
    "@spechtlabs/backstage-plugin-tailscale-common": "workspace:^"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.8",
    "@backstage/frontend-test-utils": "^1.0.0",
    "@testing-library/dom": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  }
}
