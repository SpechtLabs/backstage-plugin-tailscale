{
  "name": "@spechtlabs/backstage-plugin-tailscale-common",
  "version": "0.1.0",
  "description": "Shared by the Tailscale Backstage plugin's packages: the Tailscale entity kind, its validation and relations, and the API types.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/SpechtLabs/backstage-plugin-tailscale/tree/main/plugins/tailscale-common#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpechtLabs/backstage-plugin-tailscale.git",
    "directory": "plugins/tailscale-common"
  },
  "bugs": {
    "url": "https://github.com/SpechtLabs/backstage-plugin-tailscale/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "tailscale",
    "tailnet",
    "acl",
    "policy"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
